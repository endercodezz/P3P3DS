; P3P3DS GE vertex shader (PICA200).
; Positions arrive already in PSP screen space as homogeneous coordinates
; (x*w, y*w, z*w, w) -- the GE transform runs on the CPU in core/src/ge --
; and `projection` maps screen pixels to PICA clip space (depth range [-1,0]).
; Texture coordinates arrive in texels; `uvscale` = (1/width, 1/height).
; Colours arrive as unsigned bytes (0..255).

.fvec projection[4]
.fvec uvscale

.constf consts(0.00392156862745, 0.0, 1.0, 0.0)
.alias  inv255 consts.xxxx

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intc  v1
.alias inclr v2

.proc main
	dp4 outpos.x, projection[0], inpos
	dp4 outpos.y, projection[1], inpos
	dp4 outpos.z, projection[2], inpos
	dp4 outpos.w, projection[3], inpos

	mul outtc0, uvscale, intc

	mul outclr, inv255, inclr

	end
.end
